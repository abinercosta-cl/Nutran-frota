# Connection string do PostgreSQL (Neon)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
PORT=3001
NODE_ENV=development

# Autenticação JWT
JWT_SECRET="segredo-jwt-longo-e-aleatorio-para-desenvolvimento"
JWT_REFRESH_SECRET="segredo-jwt-refresh-longo-e-aleatorio-para-desenvolvimento"

# Seed manual de administrador inicial (scripts/seed-admin.ts)
SEED_ADMIN_MATRICULA="0001"
SEED_ADMIN_SENHA="senha-forte-temporaria"
SEED_ADMIN_NOME="Administrador Inicial"
SEED_ADMIN_LOTACAO="SNM — Sede"

